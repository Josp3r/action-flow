{
  "name": "@action-flow/core",
  "version": "0.1.0",
  "description": "Framework-agnostic, dispatch-driven action runtime for TypeScript",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Josp3r/action-flow.git", "directory": "packages/core" },
  "homepage": "https://github.com/Josp3r/action-flow/tree/main/packages/core#readme",
  "bugs": { "url": "https://github.com/Josp3r/action-flow/issues" },
  "keywords": ["typescript", "actions", "dispatch", "runtime", "tracing"],
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "sideEffects": false,
  "files": ["dist", "CHANGELOG.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  }
}
