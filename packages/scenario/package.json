{
  "name": "@action-flow/scenario",
  "version": "0.1.0",
  "description": "Isolated, typed debug scenarios for ActionFlow",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Josp3r/action-flow.git", "directory": "packages/scenario" },
  "homepage": "https://github.com/Josp3r/action-flow/tree/main/packages/scenario#readme",
  "bugs": { "url": "https://github.com/Josp3r/action-flow/issues" },
  "keywords": ["typescript", "actions", "scenarios", "mock", "fixtures"],
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "sideEffects": false,
  "files": ["dist", "CHANGELOG.md"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "dependencies": { "@action-flow/core": "workspace:*" },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
  }
}
